---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { findRelatedArticles } from '../../utils/blog';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, relatedArticles: findRelatedArticles(post, posts, 4) },
	}));
}
type Props = {
	post: CollectionEntry<'blog'>;
	relatedArticles: CollectionEntry<'blog'>[];
};

const { post, relatedArticles } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} content={post.body} relatedArticles={relatedArticles}>
	<Content />
</BlogPost>
