---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { render } from 'astro:content';
import { findRelatedArticles } from '../../utils/blog';
import { convertObsidianLinks } from '../../utils/obsidian-links';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const allPosts = await getCollection('blog');

// Convert Obsidian-style links in the post body before rendering
const processedPost = {
	...post,
	body: convertObsidianLinks(post.body, allPosts)
};

const { Content } = await render(processedPost);
const relatedArticles = findRelatedArticles(post, allPosts, 4);
---

<BlogPost {...post.data} content={processedPost.body} relatedArticles={relatedArticles}>
	<Content />
</BlogPost>
