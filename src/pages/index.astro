---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import ArticleCardGrid from '../components/content/ArticleCardGrid.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getAllArticles } from '../utils/blog';

const articles = await getAllArticles();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-super-mario-red-500">
		<Header />
		<main class="max-w-4xl mx-auto px-4 py-8">
			<section class="mb-8">
				<p class="text-lg">
					Welcome to my corner of the web. Here you'll find my thoughts on technology, development, and more.
				</p>
			</section>
			
			<section>
				<div class="flex justify-between items-center mb-6">
					<h2 class="text-2xl">Latest Articles</h2>
					<a 
						href="/blog" 
					>
						View All →
					</a>
				</div>
				<ArticleCardGrid articles={articles} maxCards={3} showViewAllLink={false} />
			</section>
		</main>
	</body>
</html>
