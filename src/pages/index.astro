---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import ArticleCardGrid from '../components/content/ArticleCardGrid.astro';
import ArcadeButton from '../components/ArcadeButton.astro';
import MarioPipe from '../components/MarioPipe.astro';
// removed MarioCoin; no longer used in title background
import CloudWide from '../components/clouds/CloudWide.astro';
import CloudTall from '../components/clouds/CloudTall.astro';
import CloudSmall from '../components/clouds/CloudSmall.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getAllArticles } from '../utils/blog';

const articles = await getAllArticles();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="max-w-6xl mx-auto px-6 py-12">
			<!-- 🎮 TITLE SCREEN: Unique intro panel -->
			<section class="mb-16">
				<div class="relative overflow-hidden">
					<!-- vignette sky backdrop -->
					<div class="relative rounded-sm border-4 border-black bg-mario-bros-blue-400 overflow-hidden">
						<!-- animated background elements: pixel-art clouds -->
						<div class="absolute inset-0 z-10 pointer-events-none">
							<!-- Cloud 1 (wide) -->
							<div class="cloud cloud-1" aria-hidden="true">
								<CloudWide class="cloud-svg" />
							</div>
							<!-- Cloud 2 (tall) -->
							<div class="cloud cloud-2" aria-hidden="true">
								<CloudTall class="cloud-svg" />
							</div>
							<!-- Cloud 3 (small) -->
							<div class="cloud cloud-3" aria-hidden="true">
								<CloudSmall class="cloud-svg" />
							</div>
						</div>

						<div
							class="absolute inset-0 z-0 opacity-15 pointer-events-none"
							style="background-image: radial-gradient(ellipse at center, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 60%);"
						></div>

						<!-- title -->
						<div class="relative z-20 px-6 md:px-8 pt-8 pb-2 text-center">
							<h1 class="font-pixelated text-white text-3xl md:text-4xl tracking-widest text-shadow-lg">JORGE HERRERA</h1>
							<p class="mt-2 text-white/90 text-xs md:text-sm tracking-wider">Created this blog for me; don't care if you don't like it</p>
						</div>

						<!-- menu options -->
						<div class="relative z-20 px-6 md:px-8 py-6 grid place-items-center">
							<div class="w-full max-w-md space-y-3">
								<ArcadeButton href="/about/" label="START" />
								<ArcadeButton href="/blog/" label="VIEW BLOG" variant="secondary" heightClass="h-10" labelClass="text-xs" />
								<ArcadeButton href="/tags/" label="EXPLORE WORLDS" variant="secondary" heightClass="h-10" labelClass="text-xs" />
							</div>
						</div>

						<!-- footer like copyright line -->
						<div class="relative z-20 px-6 md:px-8 pb-4">
							<div
								class="h-10 border-t-4 border-black bg-mario-bros-lava-700 grid place-items-center"
								style="background-image: repeating-linear-gradient(0deg, rgba(0,0,0,0.25) 0 2px, transparent 2px 8px), repeating-linear-gradient(90deg, rgba(0,0,0,0.25) 0 2px, transparent 2px 8px);"
							>
								<span class="font-pixelated text-white text-xs tracking-widest">© {new Date().getFullYear()} JORGE H</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- 🎮 SECOND SECTION: Level Selection (Three Column Grid) -->
			<section>
				<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 sm:gap-0 mb-8">
					<h2 class="text-2xl font-normal tracking-wide flex items-center gap-3 text-white text-shadow-black shadow-2xl">
						LATEST ARTICLES
					</h2>
					<ArcadeButton href="/blog/" label="VIEW ALL" full={false} variant="secondary" heightClass="h-10" labelClass="text-xs" />
				</div>
				<ArticleCardGrid articles={articles} maxCards={3} showViewAllLink={false} />
			</section>

			<!-- 🎯 SECRET WARP ZONE: pipe into the Level Editor (Sveltia CMS at /admin/) -->
			<section class="mt-16 flex justify-end">
				<a href="/admin/" class="group flex flex-col items-center gap-2 no-underline" aria-label="Warp to the Level Editor">
					<span class="font-pixelated text-xs tracking-widest text-white/60 text-shadow-2xs transition-colors group-hover:text-white group-focus-visible:text-white">LEVEL EDITOR</span>
					<span class="transition-transform group-hover:-translate-y-1 motion-reduce:transition-none">
						<MarioPipe width={70} height={89} />
					</span>
				</a>
			</section>
		</main>
	</body>
</html>

<style is:global>
	.cloud { position: absolute; opacity: 0.85; animation-timing-function: linear; }
	.cloud-svg { display: block; image-rendering: pixelated; shape-rendering: crispEdges; }
	.cloud-1 { top: 22px; left: -40px; animation: drift-right 65s infinite; }
	.cloud-2 { top: 78px; left: calc(100% - 40px); animation: drift-left 85s infinite; opacity: 0.7; }
	.cloud-3 { top: 128px; left: -20px; animation: drift-right 55s infinite; opacity: 0.8; }
	.cloud-1 .cloud-svg { width: 168px; height: auto; }
	.cloud-2 .cloud-svg { width: 120px; height: auto; }
	.cloud-3 .cloud-svg { width: 96px; height: auto; }

	@keyframes drift-right {
		0% { transform: translateX(0); }
		100% { transform: translateX(140vw); }
	}
	@keyframes drift-left {
		0% { transform: translateX(0); }
		100% { transform: translateX(-140vw); }
	}

	/* removed coin bob animation */

	/* Respect users who prefer reduced motion */
	@media (prefers-reduced-motion: reduce) {
		.cloud { animation: none; }
	}
</style>
