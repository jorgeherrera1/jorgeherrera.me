---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import ArticleList from '../components/content/ArticleList.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getAllArticles } from '../utils/blog';

const articles = await getAllArticles();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-slate-900 text-slate-100 font-mono">
		<Header />
		<main class="max-w-4xl mx-auto px-4 py-8">
			<header class="mb-8">
				<h1 class="text-3xl font-bold mb-4 text-amber-400">Jorge Herrera</h1>
				<p class="text-slate-400 text-lg">
					Welcome to my corner of the web. Here you'll find my thoughts on technology, development, and more.
				</p>
			</header>
			
			<section>
				<h2 class="text-2xl font-semibold mb-6 text-slate-200">Latest Articles</h2>
				<ArticleList articles={articles} />
			</section>
		</main>
	</body>
</html>
