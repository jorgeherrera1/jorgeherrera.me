---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import ArticleCardGrid from '../components/content/ArticleCardGrid.astro';
import TagList from '../components/TagList.astro';
import QuestionBlock from '../components/QuestionBlock.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getAllArticles } from '../utils/blog';
import { getAllTags } from '../utils/tags';

const articles = await getAllArticles();
const allTags = await getAllTags();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="max-w-6xl mx-auto px-6 py-12">
			<!-- QuestionBlock Component Testing -->
			<div class="mb-8 flex items-center gap-4">
				<QuestionBlock />
				<span>QuestionBlock Component</span>
			</div>
			
			<!-- 🎮 FIRST SECTION: Two Column Grid (50/50) -->
			<section class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
				<!-- Left Column: Character Info Box -->
				<div class="border-2 p-8 rounded-md">
					<div class="flex items-center gap-4 mb-6">
						<div class="w-12 h-12 border-2 rounded-md flex items-center justify-center font-bold text-xl">
							J
						</div>
						<div>
							<h2 class="text-lg font-normal tracking-wide">PLAYER</h2>
							<p class="text-sm">JORGE HERRERA</p>
						</div>
					</div>
					<div class="space-y-4 leading-relaxed">
						<p>
							Welcome to my corner of the web! I'm a developer passionate about creating 
							digital experiences that push boundaries.
						</p>
						<p>
							Here you'll find my thoughts on technology, web development, design patterns, 
							and the ever-evolving landscape of software engineering.
						</p>
						<div class="flex items-center gap-2 mt-6">
							<span>●</span>
							<span class="text-sm">STATUS: ONLINE</span>
						</div>
					</div>
				</div>

				<!-- Right Column: Power-up Tag Cloud -->
				<div class="border-2 p-8 rounded-md">
					<h2 class="text-lg font-normal tracking-wide mb-6 flex items-center gap-2">
						<span>⚡</span>
						POWER-UPS
					</h2>
					<div class="flex flex-wrap gap-3">
						{allTags.map(tag => (
							<a 
								href={`/tags/${typeof tag === 'string' ? tag : tag.name}`}
								class="inline-flex items-center gap-2 px-3 py-2 border-2 text-sm rounded-md hover:translate-x-1 hover:translate-y-1 transition-all duration-200"
							>
								<span>⭐</span>
								{(typeof tag === 'string' ? tag : tag.name).toUpperCase()}
							</a>
						))}
					</div>
				</div>
			</section>

			<!-- 🎮 SECOND SECTION: Level Selection (Three Column Grid) -->
			<section>
				<div class="flex justify-between items-center mb-8">
					<h2 class="text-2xl font-normal tracking-wide flex items-center gap-3">
						<span>🏰</span>
						LATEST ARTICLES
					</h2>
					<a 
						href="/blog" 
						class="px-4 py-2 border-2 hover:translate-x-1 hover:translate-y-1 transition-all duration-200 text-sm tracking-wide"
					>
						VIEW ALL →
					</a>
				</div>
				<ArticleCardGrid articles={articles} maxCards={3} showViewAllLink={false} />
			</section>
		</main>
	</body>
</html>
