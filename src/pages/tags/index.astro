---
import { getAllTags, normalizeTag } from '../../utils/tags.ts';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import MarioPipe from '../../components/MarioPipe.astro';
import PiranhaPlant from '../../components/PiranhaPlant.astro';

const tags = await getAllTags();

const displayName = (slug: string) => slug.replace(/-/g, ' ').toUpperCase();

---

<html lang="en">
  <head>
    <BaseHead title="Tags" description="Browse articles by tag" />
  </head>

  <body>
    <Header />
    <main class="relative max-w-6xl mx-auto px-6 py-12">
      <div class="relative z-10">
        {tags.length > 0 ? (
          <div class="px-2 sm:px-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
              {tags.map((tag, index) => {
                return (
                  <a
                    href={`/tags/${normalizeTag(tag.name)}`}
                    class="group block focus:outline-none"
                    aria-label={`View ${tag.count} article${tag.count === 1 ? '' : 's'} tagged with ${displayName(tag.name)}`}
                  >
                    <div class="mx-auto mb-3 transform transition-transform duration-150 group-active:translate-y-1 relative">
                      <MarioPipe class="mx-auto" width={120} height={150} />
                      
                      <!-- Animated Piranha Plant -->
                      <div 
                        class="absolute top-0 left-1/2 transform -translate-x-1/2 piranha-plant-container"
                        style={`animation-delay: ${index * 2.5}s;`}
                      >
                        <PiranhaPlant width={48} height={60} class="piranha-plant-animated" />
                      </div>
                    </div>
                    <div class={`mt-3 text-center font-pixelated text-white text-xs tracking-widest`}>{displayName(tag.name)}</div>
                    <div class="mt-1 text-center text-white/80 text-[10px] font-pixelated tracking-widest">x{tag.count}</div>
                  </a>
                );
              })}
            </div>
          </div>
        ) : (
          <div class="border-4 border-black bg-mario-bros-blue-600 text-white p-10 text-center font-pixelated">
            NO TAGS YET
          </div>
        )}
      </div>
    </main>

    <style>
      .brick {
        background-color: var(--color-mario-bros-lava-600);
        background-image:
          linear-gradient(0deg, rgba(0,0,0,0.25) 0, rgba(0,0,0,0.25) 4px, transparent 4px),
          repeating-linear-gradient(0deg, transparent 0, transparent 18px, rgba(0,0,0,0.25) 18px, rgba(0,0,0,0.25) 22px),
          repeating-linear-gradient(90deg, transparent 0, transparent 18px, rgba(0,0,0,0.25) 18px, rgba(0,0,0,0.25) 22px);
        image-rendering: pixelated;
      }
      .ground {
        background-color: var(--color-mario-bros-lava-700);
        background-image:
          repeating-linear-gradient(0deg, rgba(0,0,0,0.25) 0, rgba(0,0,0,0.25) 4px, transparent 4px, transparent 20px),
          repeating-linear-gradient(90deg, rgba(0,0,0,0.25) 0, rgba(0,0,0,0.25) 4px, transparent 4px, transparent 20px);
        image-rendering: pixelated;
      }

      /* Piranha Plant animations */
      .piranha-plant-container {
        animation: piranha-emerge 8s infinite ease-in-out;
        z-index: 5;
      }

      .piranha-plant-animated {
        transform: translateY(60px); /* Start hidden in pipe */
      }

      @keyframes piranha-emerge {
        0% { transform: translateX(-50%) translateY(45px); } /* Hidden in pipe */
        15% { transform: translateX(-50%) translateY(15px); } /* Emerge */
        25% { transform: translateX(-50%) translateY(10px); } /* Fully emerged */
        45% { transform: translateX(-50%) translateY(10px); } /* Stay visible */
        55% { transform: translateX(-50%) translateY(15px); } /* Start retracting */
        70% { transform: translateX(-50%) translateY(30px); } /* Halfway back */
        85% { transform: translateX(-50%) translateY(45px); } /* Back in pipe */
        100% { transform: translateX(-50%) translateY(45px); } /* Hidden */
      }

      /* Respect users who prefer reduced motion */
      @media (prefers-reduced-motion: reduce) {
        .piranha-plant-container {
          animation: none;
          transform: translateX(-50%) translateY(45px);
        }
      }
    </style>
  </body>
</html>