---
import { getAllTags } from '../../utils/tags.ts';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TagList from '../../components/TagList.astro';

const tags = await getAllTags();
const allTagNames = tags.map(tag => tag.name);
---

<html lang="en">
  <head>
    <BaseHead title="Tags" description="Browse articles by tag" />
  </head>

  <body>
    <Header />
    <main class="max-w-4xl mx-auto px-4 py-8">
      <article class="max-w-prose mx-auto">
        <header class="mb-8 border-b border-gray-300 pb-6">
          <h1 class="text-3xl font-bold mb-4 leading-tight font-mono">Tags</h1>
          <p class="text-gray-600 dark:text-gray-400">Browse articles by topic</p>
        </header>
        
        <div class="space-y-6">
          {tags.length > 0 ? (
            <div>
              <h2 class="text-xl font-semibold mb-4 font-mono">All Tags</h2>
              <TagList tags={allTagNames} />
            </div>
          ) : (
            <p class="text-gray-600 dark:text-gray-400">No tags found.</p>
          )}
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>