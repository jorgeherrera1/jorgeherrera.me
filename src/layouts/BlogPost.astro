---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import TagList from '../components/TagList.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import MarioTitleBlock from '../components/MarioTitleBlock.astro';
import MarioCoin from '../components/MarioCoin.astro';
import { calculateReadingTime, formatDate, formatDateForAttribute, generateExcerpt } from '../utils/blog';

type Props = CollectionEntry<'blog'>['data'] & {
  content?: string | undefined;
  relatedArticles?: CollectionEntry<'blog'>[];
};

const { title, date, tags, content, relatedArticles } = Astro.props;
const readingTime = content ? calculateReadingTime(content) : 0;
const metaDescription = generateExcerpt(content ?? '', 160);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={metaDescription} />
	</head>

	<body>
		<Header />

		<main class="px-6 py-10">
			<div class="max-w-3xl mx-auto">
				<!-- 🎮 LEVEL SELECTOR (Back Navigation) -->
				<nav class="mb-8">
					<a
						href="/blog/"
						class="inline-flex items-center gap-2 px-4 py-2 border-4 border-black bg-white text-black rounded-sm shadow-[4px_4px_0_0_rgba(0,0,0,1)] active:translate-x-[2px] active:translate-y-[2px] active:shadow-[2px_2px_0_0_rgba(0,0,0,1)] transition-all text-xs tracking-widest"
						aria-label="Back to level selection"
					>
						BACK TO LEVELS
					</a>
				</nav>

				<!-- 🏰 MARIO TITLE BLOCK (unchanged) -->
				<MarioTitleBlock title={title} />

				<!-- 📖 ARTICLE WRAPPER -->
				<section class="relative mt-6">
					<!-- Pixel drop shadow -->
					<div class="absolute inset-0 translate-x-2 translate-y-2 bg-mario-bros-blue-950 rounded-sm opacity-90"></div>

					<article class="relative border-4 border-black rounded-sm overflow-hidden bg-mario-bros-blue-50 text-black">
						<!-- Inner bezels -->
						<div class="absolute inset-0 pointer-events-none">
							<div class="absolute inset-1 border-4 border-white/70"></div>
							<div class="absolute inset-2 border-4 border-mario-bros-blue-300"></div>
						</div>

						<!-- Status bar -->
						<div class="relative h-10 border-b-4 border-black bg-mario-bros-blue-200 flex items-center justify-between px-4">
							<!-- tiny rivets -->
							<div class="absolute top-1 left-1 w-2 h-2 bg-white border-2 border-black"></div>
							<div class="absolute top-1 right-1 w-2 h-2 bg-white border-2 border-black"></div>
							<div class="flex items-center gap-2 text-xs tracking-widest">
								<MarioCoin />
								<time datetime={formatDateForAttribute(date)} class="font-pixelated">{formatDate(date)}</time>
							</div>
							<div class="px-2 py-0.5 border-2 border-black bg-white text-black rounded-sm text-[10px] tracking-widest">
								{readingTime} MIN
							</div>
						</div>

						<!-- Content -->
						<div class="px-6 md:px-8 py-8">
							<div class="prose prose-lg max-w-none leading-8
								[&>p]:mb-6 [&>p]:leading-8
								[&>h1]:text-2xl [&>h1]:font-normal [&>h1]:tracking-wide [&>h1]:border-b-4 [&>h1]:pb-2 [&>h1]:mb-6 [&>h1]:mt-10
								[&>h2]:text-xl [&>h2]:font-normal [&>h2]:tracking-wide [&>h2]:border-b-4 [&>h2]:pb-2 [&>h2]:mb-6 [&>h2]:mt-10
								[&>h3]:text-lg [&>h3]:font-normal [&>h3]:tracking-wide [&>h3]:border-b-4 [&>h3]:pb-2 [&>h3]:mb-6 [&>h3]:mt-10
								[&>a]:no-underline hover:[&>a]:underline
								[&>strong]:font-bold
								[&>code]:px-2 [&>code]:py-1 [&>code]:rounded [&>code]:text-sm [&>code]:bg-mario-bros-blue-100
								[&>pre]:border-4 [&>pre]:p-4 [&>pre]:rounded-sm [&>pre]:mb-8 [&>pre]:bg-white
								[&_.astro-code]:border-4 [&_.astro-code]:rounded-sm [&_.astro-code]:p-4
								[&>blockquote]:border-l-4 [&>blockquote]:p-4 [&>blockquote]:rounded-r-sm [&>blockquote]:mb-8 [&>blockquote]:bg-white
								[&>ul]:mb-8 [&>ul]:pl-8 [&>li]:mb-2 [&>li]:leading-7
								[&>ol]:mb-8 [&>ol]:pl-8">
								<slot />
							</div>
						</div>

						<!-- Tags footer -->
						<footer class="px-6 md:px-8 py-4 border-t-4 border-black bg-mario-bros-blue-200" style="background-image: repeating-linear-gradient(0deg, rgba(0,0,0,0.12) 0 2px, transparent 2px 8px), repeating-linear-gradient(90deg, rgba(0,0,0,0.12) 0 2px, transparent 2px 8px);">
							<TagList 
								tags={tags || []}
								className=""
								tagClass="bg-white text-black border-black shadow-[2px_2px_0_0_rgba(0,0,0,1)] hover:shadow-[3px_3px_0_0_rgba(0,0,0,1)] grid place-items-center leading-none"
							/>
						</footer>
					</article>
				</section>

				<!-- 🎯 RELATED LEVELS -->
				{relatedArticles && relatedArticles.length > 0 && (
					<section class="relative mt-10">
						<div class="absolute inset-0 translate-x-2 translate-y-2 bg-mario-bros-blue-950 rounded-sm opacity-90"></div>
						<div class="relative border-4 border-black rounded-sm p-6 bg-white">
							<div class="flex items-center gap-2 mb-4">
								<span>🎯</span>
								<h2 class="text-xl font-normal tracking-wide">RELATED LEVELS</h2>
							</div>
							<RelatedArticles articles={relatedArticles} />
						</div>
					</section>
				)}
			</div>
		</main>
	</body>
</html>
