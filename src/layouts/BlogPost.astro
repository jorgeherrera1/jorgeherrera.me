---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import TagList from '../components/TagList.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { calculateReadingTime, formatDate, formatDateForAttribute } from '../utils/blog.ts';

type Props = CollectionEntry<'blog'>['data'] & {
  content?: string;
  relatedArticles?: CollectionEntry<'blog'>[];
};

const { title, description, date, tags, content, relatedArticles } = Astro.props;
const readingTime = content ? calculateReadingTime(content) : 0;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body class="bg-slate-900 text-slate-100 font-mono">
		<Header />
		<main class="max-w-4xl mx-auto px-4 py-8">
			<article class="max-w-prose mx-auto">
				<nav class="mb-6">
					<a 
						href="/blog" 
						class="inline-flex items-center px-3 py-2 text-sm text-slate-400 bg-slate-800 border border-slate-700 rounded-md hover:text-blue-400 hover:bg-slate-700 hover:border-blue-500 hover:-translate-x-1 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
						aria-label="Back to all articles"
					>
						← Back to Articles
					</a>
				</nav>
				<header class="mb-8 border-b border-slate-700 pb-6">
					<div class="flex items-center gap-3 text-sm text-slate-400 mb-2">
						<time datetime={formatDateForAttribute(date)}>
							{formatDate(date)}
						</time>
						{readingTime > 0 && (
							<>
								<span>•</span>
								<span>{readingTime} min read</span>
							</>
						)}
					</div>
					<h1 class="text-3xl font-bold mb-4 leading-tight text-amber-400">{title}</h1>
					<TagList tags={tags || []} />
				</header>
				<div class="max-w-none leading-relaxed tracking-wide prose prose-invert prose-pre:bg-slate-800 prose-pre:text-slate-100">
					<slot />
				</div>
				{relatedArticles && relatedArticles.length > 0 && (
					<RelatedArticles articles={relatedArticles} />
				)}
			</article>
		</main>
	</body>
</html>
