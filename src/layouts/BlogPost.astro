---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import { calculateReadingTime, formatDate, formatDateForAttribute } from '../utils/blog.ts';

type Props = CollectionEntry<'blog'>['data'] & {
  content?: string;
};

const { title, description, date, tags, content } = Astro.props;
const readingTime = content ? calculateReadingTime(content) : 0;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="max-w-4xl mx-auto px-4 py-8">
			<article class="max-w-prose mx-auto">
				<header class="mb-8 border-b border-gray-300 pb-6">
					<div class="flex items-center gap-3 text-sm text-gray-600 mb-2 font-mono">
						<time datetime={formatDateForAttribute(date)}>
							{formatDate(date)}
						</time>
						{readingTime > 0 && (
							<>
								<span>•</span>
								<span>{readingTime} min read</span>
							</>
						)}
					</div>
					<h1 class="text-3xl font-bold mb-4 leading-tight font-mono">{title}</h1>
					<TagList tags={tags || []} />
				</header>
				<div class="prose max-w-none">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
