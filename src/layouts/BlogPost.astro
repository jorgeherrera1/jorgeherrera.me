---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, date, tags } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="max-w-4xl mx-auto px-4 py-8">
			<article class="max-w-prose mx-auto">
				<header class="mb-8 border-b border-gray-300 pb-6">
					<div class="text-sm text-gray-600 mb-2 font-mono">
						<FormattedDate date={date} />
					</div>
					<h1 class="text-3xl font-bold mb-4 leading-tight font-mono">{title}</h1>
					<TagList tags={tags || []} />
				</header>
				<div class="prose max-w-none">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
