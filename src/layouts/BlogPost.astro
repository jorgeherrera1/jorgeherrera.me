---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import TagList from '../components/TagList.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { calculateReadingTime, formatDate, formatDateForAttribute } from '../utils/blog.ts';

type Props = CollectionEntry<'blog'>['data'] & {
  content?: string;
  relatedArticles?: CollectionEntry<'blog'>[];
};

const { title, description, date, tags, content, relatedArticles } = Astro.props;
const readingTime = content ? calculateReadingTime(content) : 0;

// Game level indicators
const levelIcon = readingTime <= 3 ? "🟢" : readingTime <= 7 ? "🟡" : "🔴";
const difficulty = readingTime <= 3 ? "EASY" : readingTime <= 7 ? "MEDIUM" : "HARD";
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body class="bg-bg-primary text-text-primary font-primary">
		<Header />
		
		<!-- 🗺️ FLOATING GAME MAP (Table of Contents) -->
		<aside class="fixed top-1/2 right-8 -translate-y-1/2 max-h-[60vh] overflow-y-auto z-30 hidden xl:block">
			<div class="bg-bg-card border-2 border-border-accent shadow-block rounded-md p-4 min-w-64">
				<div class="flex items-center gap-2 mb-4 pb-2 border-b-2 border-border-primary">
					<span class="text-fire-orange">🗺️</span>
					<h3 class="text-coin-gold text-sm font-mono tracking-wide">LEVEL MAP</h3>
				</div>
				<nav class="toc-nav text-xs space-y-1">
					<!-- TOC will be populated by JavaScript -->
				</nav>
			</div>
		</aside>

		<main class="max-w-6xl mx-auto px-6 py-8">
			<div class="xl:mr-80">
				<!-- 🎮 LEVEL SELECTOR (Back Navigation) -->
				<nav class="mb-8">
					<a 
						href="/blog" 
						class="inline-flex items-center gap-2 px-4 py-2 bg-bg-card border-2 border-border-primary text-text-secondary hover:text-coin-gold hover:border-fire-orange shadow-pixel hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all duration-200 text-sm font-mono tracking-wide"
						aria-label="Back to level selection"
					>
						<span>◀️</span>
						BACK TO LEVELS
					</a>
				</nav>

				<!-- 🏰 LEVEL HEADER -->
				<header class="bg-bg-card border-2 border-border-accent shadow-block rounded-md p-8 mb-8">
					<div class="flex items-center justify-between mb-4">
						<div class="flex items-center gap-3">
							<span class="text-2xl">{levelIcon}</span>
							<div>
								<div class="text-xs text-text-muted font-mono">LEVEL DIFFICULTY</div>
								<div class="text-fire-orange text-sm font-mono">{difficulty}</div>
							</div>
						</div>
						<div class="text-right">
							<time datetime={formatDateForAttribute(date)} class="text-text-muted text-sm font-mono">
								{formatDate(date)}
							</time>
							{readingTime > 0 && (
								<div class="flex items-center gap-1 text-text-muted text-sm font-mono mt-1">
									<span>⏱️</span>
									<span>{readingTime} MIN</span>
								</div>
							)}
						</div>
					</div>
					
					<h1 class="text-coin-gold text-3xl font-normal leading-tight mb-6 tracking-wide">
						{title.toUpperCase()}
					</h1>
					
					<div class="border-t-2 border-border-primary pt-4">
						<div class="flex items-center gap-2 mb-3">
							<span class="text-fire-orange">⚡</span>
							<span class="text-text-muted text-sm font-mono">POWER-UPS AVAILABLE</span>
						</div>
						<TagList tags={tags || []} />
					</div>
				</header>

				<!-- 📖 LEVEL CONTENT -->
				<article class="bg-bg-secondary border-2 border-border-primary shadow-block rounded-md p-8 mb-8">
					<div class="prose prose-xl prose-invert max-w-none font-mono leading-8 
						[&>p]:mb-8 [&>p]:leading-8 [&>p]:text-text-secondary 
						[&>h1]:text-coin-gold [&>h1]:font-primary [&>h1]:text-2xl [&>h1]:font-normal [&>h1]:tracking-wide [&>h1]:border-b-2 [&>h1]:border-border-primary [&>h1]:pb-2 [&>h1]:mb-6 [&>h1]:mt-8
						[&>h2]:text-coin-gold [&>h2]:font-primary [&>h2]:text-xl [&>h2]:font-normal [&>h2]:tracking-wide [&>h2]:border-b-2 [&>h2]:border-border-primary [&>h2]:pb-2 [&>h2]:mb-6 [&>h2]:mt-8
						[&>h3]:text-coin-gold [&>h3]:font-primary [&>h3]:text-lg [&>h3]:font-normal [&>h3]:tracking-wide [&>h3]:border-b-2 [&>h3]:border-border-primary [&>h3]:pb-2 [&>h3]:mb-6 [&>h3]:mt-8
						[&>a]:text-ice-blue [&>a]:no-underline hover:[&>a]:text-sky-blue hover:[&>a]:underline
						[&>strong]:text-text-primary [&>strong]:font-bold
						[&>code]:bg-bg-tertiary [&>code]:text-molten-yellow [&>code]:px-2 [&>code]:py-1 [&>code]:rounded [&>code]:text-sm
						[&>pre]:bg-bg-tertiary [&>pre]:border-2 [&>pre]:border-border-primary [&>pre]:shadow-pixel [&>pre]:p-4 [&>pre]:rounded-md [&>pre]:mb-8
						[&>blockquote]:border-l-4 [&>blockquote]:border-fire-orange [&>blockquote]:bg-bg-tertiary [&>blockquote]:p-4 [&>blockquote]:rounded-r-md [&>blockquote]:mb-8
						[&>ul]:mb-8 [&>ul]:pl-8 [&>li]:mb-2 [&>li]:leading-7
						[&>ol]:mb-8 [&>ol]:pl-8">
						<slot />
					</div>
				</article>

				<!-- 🎯 RELATED LEVELS -->
				{relatedArticles && relatedArticles.length > 0 && (
					<section class="bg-bg-card border-2 border-border-primary shadow-block rounded-md p-8">
						<div class="flex items-center gap-2 mb-6">
							<span class="text-fire-orange">🎯</span>
							<h2 class="text-coin-gold text-xl font-normal tracking-wide">RELATED LEVELS</h2>
						</div>
						<RelatedArticles articles={relatedArticles} />
					</section>
				)}
			</div>
		</main>

		<!-- 🎮 TABLE OF CONTENTS JAVASCRIPT -->
		<script>
			document.addEventListener('DOMContentLoaded', function() {
				const tocNav = document.querySelector('.toc-nav');
				const headings = document.querySelectorAll('article h1, article h2, article h3, article h4, article h5, article h6');
				
				if (!tocNav || headings.length === 0) return;
				
				// Generate TOC
				headings.forEach((heading, index) => {
					const id = heading.id || `heading-${index}`;
					if (!heading.id) heading.id = id;
					
					const level = parseInt(heading.tagName.substring(1));
					const link = document.createElement('a');
					link.href = `#${id}`;
					link.textContent = heading.textContent;
					link.className = `block py-1 px-2 text-text-secondary hover:text-coin-gold hover:bg-bg-tertiary rounded-sm transition-colors duration-200 font-mono tracking-wide border-l-2 border-transparent hover:border-fire-orange ${level > 2 ? 'ml-4 text-xs' : 'text-sm'}`;
					
					tocNav.appendChild(link);
				});
				
				// Highlight current section
				function highlightCurrentSection() {
					const scrollPos = window.scrollY + 100;
					let current = '';
					
					headings.forEach(heading => {
						const offsetTop = heading.offsetTop;
						if (scrollPos >= offsetTop) {
							current = heading.id;
						}
					});
					
					// Update active link
					document.querySelectorAll('.toc-nav a').forEach(link => {
						link.classList.remove('text-coin-gold', 'bg-bg-tertiary', 'border-fire-orange');
						link.classList.add('text-text-secondary', 'border-transparent');
					});
					
					if (current) {
						const activeLink = document.querySelector(`.toc-nav a[href="#${current}"]`);
						if (activeLink) {
							activeLink.classList.remove('text-text-secondary', 'border-transparent');
							activeLink.classList.add('text-coin-gold', 'bg-bg-tertiary', 'border-fire-orange');
						}
					}
				}
				
				// Smooth scroll for TOC links
				document.querySelectorAll('.toc-nav a').forEach(link => {
					link.addEventListener('click', function(e) {
						e.preventDefault();
						const target = document.querySelector(this.getAttribute('href'));
						if (target) {
							target.scrollIntoView({ behavior: 'smooth', block: 'start' });
						}
					});
				});
				
				// Update highlighting on scroll
				window.addEventListener('scroll', highlightCurrentSection);
				highlightCurrentSection(); // Initial highlight
			});
		</script>
	</body>
</html>
