---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="relative bg-mario-bros-lava border-4 p-8 mx-auto max-w-fit">
  <!-- 4 Corner Rivets -->
  <div class="absolute top-2 left-2 w-3 h-3 bg-white shadow-2xl shadow-black"></div>
  <div class="absolute top-2 right-2 w-3 h-3 bg-white"></div>
  <div class="absolute bottom-2 left-2 w-3 h-3 bg-white"></div>
  <div class="absolute bottom-2 right-2 w-3 h-3 bg-white"></div>
  
  <!-- Title Text -->
  <h1 
    class="font-pixelated text-white text-4xl text-shadow-lg text-shadow-black text-center tracking-wider leading-tight"
  >
    {title.toUpperCase()}
  </h1>
</div>