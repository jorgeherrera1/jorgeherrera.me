---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="relative bg-mario-bros-lava-600 border-4 p-4 sm:p-6 md:p-8 mx-auto max-w-full">
  <!-- 4 Corner Rivets -->
  <div class="absolute top-2 left-2 w-3 h-3 bg-white border-2 border-black"></div>
  <div class="absolute top-2 right-2 w-3 h-3 bg-white border-2 border-black"></div>
  <div class="absolute bottom-2 left-2 w-3 h-3 bg-white border-2 border-black"></div>
  <div class="absolute bottom-2 right-2 w-3 h-3 bg-white border-2 border-black"></div>
  
  <!-- Title Text -->
  <h1 
    class="font-pixelated text-white text-lg sm:text-2xl md:text-3xl lg:text-4xl text-shadow-lg text-shadow-mario-bros-blue-950 text-center tracking-wide sm:tracking-wider leading-tight break-words"
  >
    {title.toUpperCase()}
  </h1>
</div>