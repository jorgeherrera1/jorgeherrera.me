---
// Super Mario Bros authentic pipe component using SVG for pixel-perfect rendering
export interface Props {
  class?: string;
  width?: number;
  height?: number;
}

const { 
  class: className = '',
  width = 140,
  height = 178
} = Astro.props;

// Calculate dimensions based on the 16x22 pixel grid (scaled 8x for visibility)
const scale = width / 128; // Base width of 128 for 16 pixels * 8 scale
const pixelSize = 8 * scale;
---

<svg 
  viewBox="0 0 128 176" 
  class={`mario-pipe ${className}`}
  width={width}
  height={height}
  xmlns="http://www.w3.org/2000/svg"
  style="image-rendering: pixelated; image-rendering: -moz-crisp-edges; image-rendering: crisp-edges;"
>
  <!-- Using Tailwind fill utilities mapped to Mario green palette -->
  
  <!-- Pipe top (entrance/lip) - wider section (taller +8px) -->
  <g>
    <!-- Black border outline for top -->
    <rect x="0" y="0" width="128" height="48" class="fill-black"/>
    
    <!-- Main top fill -->
    <rect x="8" y="8" width="112" height="32" class="fill-mario-bros-green-400"/>
    
    <!-- Top highlights (left side) -->
    <rect x="8" y="8" width="8" height="32" class="fill-mario-bros-green-100"/>
    <rect x="24" y="8" width="8" height="32" class="fill-mario-bros-green-100"/>
    
    <!-- Top shading (right side) -->
    <rect x="96" y="8" width="24" height="32" class="fill-mario-bros-green-600"/>
    <rect x="104" y="8" width="16" height="32" class="fill-mario-bros-green-700"/>
    
    <!-- Checkerboard pattern on right edge -->
    <rect x="112" y="8" width="8" height="8" class="fill-mario-bros-green-100"/>
    <rect x="112" y="16" width="8" height="8" class="fill-mario-bros-green-700"/>
    <rect x="112" y="24" width="8" height="8" class="fill-mario-bros-green-100"/>
    <rect x="112" y="32" width="8" height="8" class="fill-mario-bros-green-700"/>
  </g>
  
  <!-- Pipe body (main shaft) -->
  <g>
    <!-- Black border outline for body -->
    <rect x="16" y="40" width="96" height="136" class="fill-black"/>
    
    <!-- Main body fill -->
    <rect x="24" y="48" width="80" height="120" class="fill-mario-bros-green-400"/>
    
    <!-- Body highlights (left side) -->
    <rect x="24" y="48" width="8" height="120" class="fill-mario-bros-green-100"/>
    <rect x="40" y="48" width="8" height="120" class="fill-mario-bros-green-100"/>
    
    <!-- Body shading (right side) -->
    <rect x="80" y="48" width="24" height="120" class="fill-mario-bros-green-600"/>
    <rect x="88" y="48" width="16" height="120" class="fill-mario-bros-green-700"/>
    
    <!-- Checkerboard pattern on right edge -->
    <g>
      <!-- Alternating squares for checkerboard effect -->
      <rect x="96" y="48" width="8" height="8" class="fill-mario-bros-green-100"/>
      <rect x="96" y="64" width="8" height="8" class="fill-mario-bros-green-100"/>
      <rect x="96" y="80" width="8" height="8" class="fill-mario-bros-green-100"/>
      <rect x="96" y="96" width="8" height="8" class="fill-mario-bros-green-100"/>
      <rect x="96" y="112" width="8" height="8" class="fill-mario-bros-green-100"/>
      <rect x="96" y="128" width="8" height="8" class="fill-mario-bros-green-100"/>
      <rect x="96" y="144" width="8" height="8" class="fill-mario-bros-green-100"/>
      <rect x="96" y="160" width="8" height="8" class="fill-mario-bros-green-100"/>
      
  <rect x="96" y="56" width="8" height="8" class="fill-mario-bros-green-700"/>
  <rect x="96" y="72" width="8" height="8" class="fill-mario-bros-green-700"/>
  <rect x="96" y="88" width="8" height="8" class="fill-mario-bros-green-700"/>
  <rect x="96" y="104" width="8" height="8" class="fill-mario-bros-green-700"/>
  <rect x="96" y="120" width="8" height="8" class="fill-mario-bros-green-700"/>
  <rect x="96" y="136" width="8" height="8" class="fill-mario-bros-green-700"/>
  <rect x="96" y="152" width="8" height="8" class="fill-mario-bros-green-700"/>
    </g>
  </g>
</svg>