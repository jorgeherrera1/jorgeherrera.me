---
// Mario Bros coin component
---

<svg 
  viewBox="0 0 20 20" 
  class="w-5 h-5 inline-block"
  xmlns="http://www.w3.org/2000/svg"
  style="filter: drop-shadow(1px 1px 2px rgba(0, 0, 0, 0.3));"
>
  <!-- Main coin circle -->
  <circle 
    cx="10" 
    cy="10" 
    r="9" 
    fill="#FFD700"
    stroke="#DAA520" 
    stroke-width="0.5"
  />
  
  <!-- Top highlight for 3D effect -->
  <ellipse 
    cx="8" 
    cy="7" 
    rx="4" 
    ry="3" 
    fill="#FFFF99" 
    opacity="0.6"
  />
  
  <!-- Bottom shadow for depth -->
  <ellipse 
    cx="12" 
    cy="13" 
    rx="3" 
    ry="2" 
    fill="#B8860B" 
    opacity="0.4"
  />
</svg>