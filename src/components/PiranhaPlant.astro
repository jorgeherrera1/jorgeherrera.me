---
// Super Mario Bros authentic Piranha Plant component using SVG for pixel-perfect rendering
export interface Props {
  class?: string;
  width?: number;
  height?: number;
}

const { 
  class: className = '',
  width = 64,
  height = 80
} = Astro.props;
---

<svg 
  viewBox="0 0 64 80" 
  class={`piranha-plant ${className}`}
  width={width}
  height={height}
  xmlns="http://www.w3.org/2000/svg"
  style="image-rendering: pixelated; image-rendering: -moz-crisp-edges; image-rendering: crisp-edges;"
>
  <!-- Green stem -->
  <g class="plant-stem">
    <!-- Main stem body -->
    <rect x="26" y="52" width="12" height="28" class="fill-mario-bros-green-500"/>
    
    <!-- Stem highlights -->
    <rect x="26" y="52" width="3" height="28" class="fill-mario-bros-green-300"/>
    <rect x="32" y="52" width="3" height="28" class="fill-mario-bros-green-300"/>
    
    <!-- Stem shadows -->
    <rect x="35" y="52" width="3" height="28" class="fill-mario-bros-green-700"/>
    
    <!-- Stem segmentation lines -->
    <rect x="26" y="60" width="12" height="1" class="fill-mario-bros-green-700"/>
    <rect x="26" y="68" width="12" height="1" class="fill-mario-bros-green-700"/>
    <rect x="26" y="76" width="12" height="1" class="fill-mario-bros-green-700"/>
  </g>

  <!-- Piranha Plant head -->
  <g class="plant-head">
    <!-- Head outline/shadow -->
    <rect x="4" y="4" width="8" height="4" class="fill-black"/>
    <rect x="12" y="2" width="40" height="4" class="fill-black"/>
    <rect x="52" y="4" width="8" height="4" class="fill-black"/>
    <rect x="2" y="8" width="4" height="32" class="fill-black"/>
    <rect x="58" y="8" width="4" height="32" class="fill-black"/>
    <rect x="4" y="40" width="8" height="4" class="fill-black"/>
    <rect x="12" y="44" width="40" height="4" class="fill-black"/>
    <rect x="52" y="40" width="8" height="4" class="fill-black"/>
    
    <!-- Main head body with curves -->
    <rect x="6" y="6" width="52" height="36" class="fill-mario-bros-lava-600"/>
    <rect x="12" y="4" width="40" height="2" class="fill-mario-bros-lava-600"/>
    <rect x="12" y="42" width="40" height="2" class="fill-mario-bros-lava-600"/>
    <rect x="4" y="8" width="2" height="32" class="fill-mario-bros-lava-600"/>
    <rect x="58" y="8" width="2" height="32" class="fill-mario-bros-lava-600"/>
    
    <!-- White spots positioned more naturally -->
    <rect x="14" y="10" width="6" height="6" class="fill-white"/>
    <rect x="28" y="8" width="8" height="8" class="fill-white"/>
    <rect x="44" y="12" width="6" height="6" class="fill-white"/>
    <rect x="12" y="22" width="6" height="6" class="fill-white"/>
    <rect x="46" y="28" width="8" height="8" class="fill-white"/>
    
    <!-- Mouth cavity (dark red/black) -->
    <rect x="14" y="28" width="36" height="12" class="fill-black"/>
    
    <!-- Upper teeth (jagged) -->
    <rect x="16" y="32" width="3" height="8" class="fill-white"/>
    <rect x="22" y="30" width="3" height="10" class="fill-white"/>
    <rect x="28" y="32" width="3" height="8" class="fill-white"/>
    <rect x="34" y="30" width="3" height="10" class="fill-white"/>
    <rect x="40" y="32" width="3" height="8" class="fill-white"/>
    <rect x="46" y="30" width="3" height="10" class="fill-white"/>
    
    <!-- Lower jaw -->
    <rect x="18" y="36" width="28" height="8" class="fill-mario-bros-lava-600"/>
    
    <!-- Lower teeth (pointing up) -->
    <rect x="20" y="36" width="3" height="6" class="fill-white"/>
    <rect x="26" y="34" width="3" height="8" class="fill-white"/>
    <rect x="32" y="36" width="3" height="6" class="fill-white"/>
    <rect x="38" y="34" width="3" height="8" class="fill-white"/>
    <rect x="44" y="36" width="3" height="6" class="fill-white"/>
    
    <!-- Head shading for depth -->
    <rect x="48" y="6" width="10" height="36" class="fill-mario-bros-lava-800"/>
    <rect x="6" y="36" width="52" height="6" class="fill-mario-bros-lava-800"/>
    
    <!-- Nostril details -->
    <rect x="24" y="18" width="2" height="2" class="fill-black"/>
    <rect x="38" y="18" width="2" height="2" class="fill-black"/>
  </g>
</svg>