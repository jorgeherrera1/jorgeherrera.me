---
import { normalizeTag } from '../utils/tags';

export interface Props {
  tags: string[];
  showLinks?: boolean;
  className?: string;
}

const { tags, showLinks = true, className = '' } = Astro.props;

// Mario power-up styling based on tag content
const getPowerUpStyle = (tag: string) => {
  const lowerTag = tag.toLowerCase();
  
  // Tech/Programming tags (Fire Flower - Red)
  if (lowerTag.includes('javascript') || lowerTag.includes('typescript') || lowerTag.includes('react') || lowerTag.includes('code')) {
    return {
      icon: '🔥',
      bgClass: '',
      borderClass: '',
      hoverClass: ''
    };
  }
  
  // Design/CSS tags (Ice Flower - Blue)
  if (lowerTag.includes('css') || lowerTag.includes('design') || lowerTag.includes('ui') || lowerTag.includes('frontend')) {
    return {
      icon: '❄️',
      bgClass: '',
      borderClass: '',
      hoverClass: ''
    };
  }
  
  // Backend/Server tags (Mushroom - Green)
  if (lowerTag.includes('backend') || lowerTag.includes('server') || lowerTag.includes('api') || lowerTag.includes('database')) {
    return {
      icon: '🍄',
      bgClass: '',
      borderClass: '',
      hoverClass: 'hover:brightness-110'
    };
  }
  
  // Tutorial/Learning tags (Star - Gold)
  if (lowerTag.includes('tutorial') || lowerTag.includes('guide') || lowerTag.includes('learn') || lowerTag.includes('tips')) {
    return {
      icon: '⭐',
      bgClass: '',
      borderClass: '',
      hoverClass: ''
    };
  }
  
  // Tools/DevOps tags (Power-up - Purple)
  if (lowerTag.includes('tools') || lowerTag.includes('devops') || lowerTag.includes('deployment') || lowerTag.includes('workflow')) {
    return {
      icon: '⚡',
      bgClass: '',
      borderClass: '',
      hoverClass: 'hover:brightness-110'
    };
  }
  
  // Default coin style
  return {
    icon: '🪙',
    bgClass: '',
    borderClass: '',
    hoverClass: ''
  };
};
---

{tags && tags.length > 0 && (
  <div class={`flex flex-wrap gap-2 ${className}`}>
    {tags.map(tag => {
      const powerUp = getPowerUpStyle(tag);
      const baseClasses = `inline-flex items-center gap-1 px-2 py-1 text-xs tracking-wide border-2 rounded-sm transition-all duration-200 font-bold ${powerUp.bgClass} ${powerUp.borderClass} ${powerUp.hoverClass} hover:translate-x-0.5 hover:translate-y-0.5`;
      
      return showLinks ? (
        <a 
          href={`/tags/${normalizeTag(tag)}`} 
          aria-label={`View all articles tagged with ${tag}`}
          class={baseClasses}
        >
          <span>{powerUp.icon}</span>
          <span>{tag.toUpperCase()}</span>
        </a>
      ) : (
        <span class={baseClasses}>
          <span>{powerUp.icon}</span>
          <span>{tag.toUpperCase()}</span>
        </span>
      );
    })}
  </div>
)}