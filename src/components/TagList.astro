---
import { normalizeTag } from '../utils/tags';

export interface Props {
  tags: string[];
  showLinks?: boolean;
  className?: string;
  tagClass?: string;
}

const { tags, showLinks = true, className = '', tagClass = '' } = Astro.props;
---

{tags && tags.length > 0 && (
  <div class={`flex flex-wrap gap-2 ${className}`}>
    {tags.map(tag => {
      const baseClasses = `inline-flex items-center px-2 py-1 text-xs tracking-wide border-2 rounded-sm transition-all duration-200 font-bold hover:translate-x-0.5 hover:translate-y-0.5`;
      
      return showLinks ? (
        <a 
          href={`/tags/${normalizeTag(tag)}/`} 
          aria-label={`View all articles tagged with ${tag}`}
          class={`${baseClasses} ${tagClass}`}
        >
          <span>{tag.toUpperCase()}</span>
        </a>
      ) : (
        <span class={`${baseClasses} ${tagClass}`}>
          <span>{tag.toUpperCase()}</span>
        </span>
      );
    })}
  </div>
)}