---
import { normalizeTag } from '../utils/tags';

export interface Props {
  tags: string[];
  showLinks?: boolean;
  className?: string;
}

const { tags, showLinks = true, className = '' } = Astro.props;
---

{tags && tags.length > 0 && (
  <div class={`tag-list ${className}`}>
    {tags.map(tag => 
      showLinks ? (
        <a 
          href={`/tags/${normalizeTag(tag)}`} 
          aria-label={`View all articles tagged with ${tag}`}
        >
          {tag}
        </a>
      ) : (
        <span class="tag">
          {tag}
        </span>
      )
    )}
  </div>
)}