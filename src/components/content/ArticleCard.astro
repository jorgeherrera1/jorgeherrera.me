---
import type { Article } from '../../utils/blog.ts';
import { formatDate, formatDateForAttribute, calculateReadingTime, generateExcerpt } from '../../utils/blog.ts';
import TagList from '../TagList.astro';

export interface Props {
  article: Article;
  variant?: 'grid' | 'featured';
  showExcerpt?: boolean;
  class?: string;
}

const { article, variant = 'grid', showExcerpt = true, class: className = '' } = Astro.props;
const readingTime = calculateReadingTime(article.body);
const excerpt = showExcerpt ? generateExcerpt(article.body, 150) : '';

// Mario block styling based on reading time
const blockData = readingTime <= 3 
  ? { 
      style: "mario-card-easy", 
      icon: "❓", 
      difficulty: "EASY", 
      powerUp: "🟢",
      bgClass: "bg-yellow-100"
    }
  : readingTime <= 7 
  ? { 
      style: "mario-card-medium", 
      icon: "🔥", 
      difficulty: "MEDIUM", 
      powerUp: "🟡",
      bgClass: "bg-red-100"
    }
  : { 
      style: "mario-card-hard", 
      icon: "⭐", 
      difficulty: "HARD", 
      powerUp: "🔴",
      bgClass: "bg-purple-100"
    };
---

<!-- Mario Question Block Card -->
<article class={`h-full flex flex-col mario-card-block ${blockData.style} group focus-within:ring-2 focus-within:ring-coin-gold focus-within:ring-offset-2 focus-within:ring-offset-bg-primary ${className}`}>
  <!-- Corner Rivets -->
  <div class="mario-card-rivet mario-card-rivet-tl"></div>
  <div class="mario-card-rivet mario-card-rivet-tr"></div>
  <div class="mario-card-rivet mario-card-rivet-bl"></div>
  <div class="mario-card-rivet mario-card-rivet-br"></div>
  
  <!-- Level Icon -->
  <div class="mario-level-icon">{blockData.icon}</div>
  
  <!-- Block Header with Game UI -->
  <header class="relative p-6 pt-12">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2">
        <span class="text-lg">{blockData.powerUp}</span>
        <span class="text-xs text-castle-black font-mono tracking-wide font-bold">LV</span>
      </div>
      <div class="text-xs text-castle-black font-mono font-bold">
        <span>{blockData.difficulty}</span>
      </div>
    </div>
    
    <h2 class="text-lg font-normal leading-tight mb-4">
      <a 
        href={`/blog/${article.id}`}
        class="text-castle-black hover:text-molten-yellow no-underline transition-colors focus:outline-none group-hover:text-molten-yellow text-shadow-pixel font-bold"
      >
        {article.data.title.toUpperCase()}
      </a>
    </h2>
    
    <div class="flex items-center justify-between text-xs text-castle-black font-mono font-bold">
      <time datetime={formatDateForAttribute(article.data.date)}>
        {formatDate(article.data.date)}
      </time>
      <div class="flex items-center gap-1">
        <span>⏱️</span>
        <span>{readingTime}MIN</span>
      </div>
    </div>
  </header>

  <!-- Level Preview Content -->
  <div class="p-6 pt-0 flex-grow flex flex-col">
    {showExcerpt && excerpt && (
      <div class={`text-castle-black text-sm leading-relaxed mb-4 flex-grow p-3 rounded-sm ${blockData.bgClass}`}>
        {excerpt}...
      </div>
    )}
    
    <!-- Start Button -->
    <div class="mt-auto">
      <a 
        href={`/blog/${article.id}`}
        class="inline-flex items-center gap-2 px-4 py-3 bg-castle-black border-2 border-dungeon-gray text-text-primary text-sm font-mono tracking-wide font-bold shadow-pixel hover:bg-dungeon-gray hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all duration-200 w-full justify-center rounded-sm"
      >
        <span>▶️</span>
        START LEVEL
      </a>
    </div>
  </div>

  <!-- Power-ups Footer -->
  <footer class="p-4 bg-castle-black border-t-2 border-dungeon-gray">
    <TagList tags={article.data.tags || []} className="" />
  </footer>
</article>