---
import type { Article } from '../../utils/blog.ts';
import { formatDate, formatDateForAttribute, calculateReadingTime, generateExcerpt } from '../../utils/blog.ts';
import TagList from '../TagList.astro';

export interface Props {
  article: Article;
  variant?: 'grid' | 'featured';
  showExcerpt?: boolean;
  class?: string;
}

const { article, variant = 'grid', showExcerpt = true, class: className = '' } = Astro.props;
const readingTime = calculateReadingTime(article.body);
const excerpt = showExcerpt ? generateExcerpt(article.body, 150) : '';
---

<article class={`h-full flex flex-col bg-slate-800 border border-slate-600 rounded-lg p-6 shadow-sm hover:border-slate-500 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 ease-in-out focus-within:ring-2 focus-within:ring-amber-400/50 focus-within:ring-offset-2 ${className}`}>
  <header class="mb-4">
    <h2 class="text-xl font-semibold mb-4 leading-tight">
      <a 
        href={`/blog/${article.id}`}
        class="text-blue-400 hover:text-blue-300 no-underline hover:underline transition-colors focus:outline-2 focus:outline-amber-400 focus:outline-offset-2 focus:rounded"
      >
        {article.data.title}
      </a>
    </h2>
    <div class="text-xs text-slate-400 font-mono space-y-1">
      <div>
        <time datetime={formatDateForAttribute(article.data.date)}>
          {formatDate(article.data.date)}
        </time>
      </div>
      <div>{readingTime} min read</div>
    </div>
  </header>
  
  {showExcerpt && excerpt && (
    <div class="text-slate-200 leading-relaxed mb-4 flex-grow line-clamp-3">
      {excerpt}
    </div>
  )}
  
  <TagList tags={article.data.tags || []} className="mt-auto pt-4 border-t border-slate-700" />
</article>