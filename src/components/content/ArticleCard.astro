---
import type { Article } from '../../utils/blog';
import { formatDate, formatDateForAttribute, calculateReadingTime, generateExcerpt } from '../../utils/blog';
import TagList from '../TagList.astro';
import ArcadeButton from '../ArcadeButton.astro';

export interface Props {
  article: Article;
  showExcerpt?: boolean;
  class?: string;
}

const { article, showExcerpt = true, class: className = '' } = Astro.props;
const readingTime = calculateReadingTime(article.body ?? '');
const excerpt = showExcerpt ? generateExcerpt(article.body ?? '', 150) : '';
---

<!-- Arcade-styled Mario card -->
<div class={`relative group ${className}`}>
  <!-- Pixel drop shadow -->
  <div class="absolute inset-0 translate-x-2 translate-y-2 bg-mario-bros-blue-950 rounded-sm opacity-90"></div>

  <article class={`relative h-full flex flex-col border-4 border-black rounded-sm overflow-hidden bg-mario-bros-lava-300`}>
    <!-- Bezels / inner frame -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute inset-1 border-4 border-white/60"></div>
      <div class="absolute inset-2 border-4 border-mario-bros-lava-700"></div>
    </div>

  <!-- Compact lava label band with more side spacing (vertically centered) -->
    <div class="relative px-6 md:px-8 h-10 border-b-4 border-black bg-mario-bros-lava-600 flex items-center justify-between">
      <!-- small rivets -->
      <div class="absolute top-1 left-1 w-2 h-2 bg-white border-2 border-black"></div>
      <div class="absolute top-1 right-1 w-2 h-2 bg-white border-2 border-black"></div>
      <span class="font-pixelated text-white text-xs tracking-widest">LEVEL</span>
      <span class="px-2 py-0.5 border-2 border-black bg-white text-black rounded-sm text-[10px] md:text-xs tracking-widest">{readingTime} MIN</span>
    </div>

    <!-- Title block -->
    <div class="px-6 md:px-8 pt-3">
      <h2 class="text-lg md:text-xl leading-snug text-mario-bros-lava-800 tracking-wider">
        <a
          href={`/blog/${article.id}`}
          class="no-underline focus:outline-none hover:underline underline-offset-4"
        >
          {article.data.title.toUpperCase()}
        </a>
      </h2>

      <div class="mt-2 text-xs opacity-90 flex items-center">
        <time datetime={formatDateForAttribute(article.data.date)}>{formatDate(article.data.date)}</time>
      </div>
    </div>

    <!-- Content / preview area with subtle tile background -->
  <div class="px-6 md:px-8 py-4 flex-grow flex flex-col relative">
      <div class="absolute inset-0 opacity-20 pointer-events-none"
           style="background-image: linear-gradient(90deg, rgba(0,0,0,0.12) 1px, transparent 1px), linear-gradient(0deg, rgba(0,0,0,0.12) 1px, transparent 1px); background-size: 12px 12px;">
      </div>

      {showExcerpt && excerpt && (
        <div class="relative text-sm leading-relaxed mb-4 flex-grow">
          {excerpt}...
        </div>
      )}

      <!-- CTA: Reusable arcade button -->
      <div class="mt-auto">
        <ArcadeButton href={`/blog/${article.id}`} ariaLabel={`Open article ${article.data.title}`} label="START" />
      </div>
    </div>

    <!-- Footer / tags like power-ups -->
  <footer class={`px-6 md:px-8 py-4 border-t-4 border-black bg-mario-bros-lava-700`} style="background-image: repeating-linear-gradient(0deg, rgba(0,0,0,0.25) 0 2px, transparent 2px 8px), repeating-linear-gradient(90deg, rgba(0,0,0,0.25) 0 2px, transparent 2px 8px);">
      <TagList 
        tags={article.data.tags || []}
        className=""
  tagClass="bg-white text-black border-black shadow-[2px_2px_0_0_rgba(0,0,0,1)] hover:shadow-[3px_3px_0_0_rgba(0,0,0,1)] grid place-items-center leading-none"
      />
    </footer>
  </article>
</div>