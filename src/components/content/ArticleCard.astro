---
import type { Article } from '../../utils/blog.ts';
import { formatDate, formatDateForAttribute, calculateReadingTime, generateExcerpt } from '../../utils/blog.ts';
import TagList from '../TagList.astro';

export interface Props {
  article: Article;
  variant?: 'grid' | 'featured';
  showExcerpt?: boolean;
  class?: string;
}

const { article, variant = 'grid', showExcerpt = true, class: className = '' } = Astro.props;
const readingTime = calculateReadingTime(article.body);
const excerpt = showExcerpt ? generateExcerpt(article.body, 150) : '';

// Game level indicators based on reading time
const levelIcon = readingTime <= 3 ? "🟢" : readingTime <= 7 ? "🟡" : "🔴";
const difficulty = readingTime <= 3 ? "EASY" : readingTime <= 7 ? "MEDIUM" : "HARD";
---

<article class={`h-full flex flex-col bg-bg-card border-2 border-border-primary shadow-block hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all duration-200 group focus-within:ring-2 focus-within:ring-coin-gold focus-within:ring-offset-2 focus-within:ring-offset-bg-primary rounded-md overflow-hidden ${className}`}>
  <!-- Level Header with Game UI -->
  <header class="bg-bg-tertiary border-b-2 border-border-primary p-4">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2">
        <span class="text-lg">{levelIcon}</span>
        <span class="text-xs text-text-muted font-mono tracking-wide">LV</span>
      </div>
      <div class="text-xs text-text-muted font-mono">
        <span class="text-fire-orange">{difficulty}</span>
      </div>
    </div>
    
    <h2 class="text-lg font-normal leading-tight mb-3">
      <a 
        href={`/blog/${article.id}`}
        class="text-coin-gold hover:text-molten-yellow no-underline transition-colors focus:outline-none group-hover:text-molten-yellow"
      >
        {article.data.title.toUpperCase()}
      </a>
    </h2>
    
    <div class="flex items-center justify-between text-xs text-text-muted font-mono">
      <time datetime={formatDateForAttribute(article.data.date)}>
        {formatDate(article.data.date)}
      </time>
      <div class="flex items-center gap-1">
        <span>⏱️</span>
        <span>{readingTime}MIN</span>
      </div>
    </div>
  </header>

  <!-- Level Preview -->
  <div class="p-4 flex-grow flex flex-col">
    {showExcerpt && excerpt && (
      <div class="text-text-secondary text-sm leading-relaxed mb-4 flex-grow">
        {excerpt}...
      </div>
    )}
    
    <!-- Start Button -->
    <div class="mt-auto">
      <a 
        href={`/blog/${article.id}`}
        class="inline-flex items-center gap-2 px-4 py-2 bg-lava-red border-2 border-mario-red text-text-primary text-sm font-mono tracking-wide shadow-pixel hover:bg-mario-red hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all duration-200 w-full justify-center rounded-sm"
      >
        <span>▶️</span>
        START LEVEL
      </a>
    </div>
  </div>

  <!-- Power-ups Footer -->
  <footer class="p-4 bg-bg-tertiary border-t-2 border-border-primary">
    <TagList tags={article.data.tags || []} className="" />
  </footer>
</article>