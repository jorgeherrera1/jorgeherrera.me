---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav class="flex items-center justify-between p-6 max-w-6xl mx-auto">
		<h1 class="font-primary text-2xl font-normal text-coin-gold tracking-wider">
			<a 
				href="/" 
				class="hover:text-molten-yellow transition-colors duration-200 hover:drop-shadow-glow-gold"
			>
				{SITE_TITLE}
			</a>
		</h1>
		<div class="flex gap-2">
			<HeaderLink href="/">HOME</HeaderLink>
			<HeaderLink href="/blog">BLOG</HeaderLink>
			<HeaderLink href="/tags">TAGS</HeaderLink>
			<HeaderLink href="/about">ABOUT</HeaderLink>
		</div>
	</nav>
</header>
