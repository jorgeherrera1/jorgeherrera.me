---
import { getCurrentDateMario } from '../utils/dateUtils';
import MarioCoin from './MarioCoin.astro';


const currentDate = getCurrentDateMario();
---

<header class="font-pixelated grid grid-cols-3 md:grid-cols-4 gap-0 p-2 md:p-4 text-white text-base md:text-xl">
	<!-- Column 1: JORGE H + Score -->
	<div class="flex flex-col items-start">
		<div class="mb-1">
			<a 
				href="/" 
				class="no-underline"
			>
				JORGE H
			</a>
		</div>
		<div>{currentDate}</div>
	</div>

	<!-- Column 2: Coin Counter -->
	<div class="flex items-start">
		<div class="flex items-center gap-1">
			<MarioCoin />
			<span>×40</span>
		</div>
	</div>

	<!-- Column 3: World Info -->
	<div class="flex flex-col items-start">
		<div class="mb-1">WORLD</div>
		<div>1-1</div>
	</div>

	<!-- Column 4: Navigation -->
	<div class="hidden md:flex items-start justify-end gap-4">
		<a href="/blog">BLOG</a>
		<a href="/tags">TAGS</a>
		<a href="/about">ABOUT</a>
	</div>
</header>
