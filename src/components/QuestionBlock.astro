---
// Mario Question Block Component
// Displays the iconic Super Mario Bros question mark block
// No props needed - always shows the question mark
---

<div class="question-block">
  <!-- 4 Corner Rivets -->
  <div class="question-block-rivet question-rivet-top-left"></div>
  <div class="question-block-rivet question-rivet-top-right"></div>
  <div class="question-block-rivet question-rivet-bottom-left"></div>
  <div class="question-block-rivet question-rivet-bottom-right"></div>
  
  <!-- Question Mark -->
  <span class="question-mark">?</span>
</div>