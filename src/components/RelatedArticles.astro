---
import { formatDate } from '../utils/blog';
import { normalizeTag } from '../utils/tags';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  articles: CollectionEntry<'blog'>[];
}

const { articles } = Astro.props;
---

{articles && articles.length > 0 && (
  <section class="related-articles">
    <h3 class="related-title">Related Articles</h3>
    <div class="related-grid">
      {articles.map(article => (
        <article class="related-item">
          <h4 class="related-item-title">
            <a href={`/blog/${article.id}/`} class="related-link">
              {article.data.title}
            </a>
          </h4>
          <time 
            class="related-date" 
            datetime={article.data.date.toISOString().split('T')[0]}
          >
            {formatDate(article.data.date)}
          </time>
          {article.data.tags && article.data.tags.length > 0 && (
            <div class="related-tags">
              {article.data.tags.slice(0, 3).map(tag => (
                <a 
                  href={`/tags/${normalizeTag(tag)}`} 
                  class="related-tag"
                  aria-label={`View articles tagged with ${tag}`}
                >
                  {tag}
                </a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
)}